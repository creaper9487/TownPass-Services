# 只放「每台電腦不一樣」或「機密」的設定；其他設定（API 開關、排程間隔…）直接改 app/config.py

# server 聽的 IP / port（同 Wi-Fi 的隊友打這個 IP）
HOST=192.168.88.208
PORT=8000

# 測試模式：假資料 + /_test/* 測試 API + 測試面板（/assistive/v1/_test/panel）。正式環境一定要 false
TEST_MODE=false

DB_PATH=data/local.db
ENABLE_BACKGROUND_JOBS=true

# ---- 機密，不要 commit ----
HOOK_SECRET=change-me
# Firebase：兩個都填才會真的推到手機；空的 = 推播只記錄在本機
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
